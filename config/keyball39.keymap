#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 10    // default: 10

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "hold-preferred";
    quick-tap-ms = <200>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    combos {
        compatible = "zmk,combos";

        config-layer-combo {
            bindings = <&mo 9>;
            key-positions = <35 36>;
        };

        tb-caret-layer {
            bindings = <&mo 8>;
            key-positions = <17 18>;
            layers = <1 2 6>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp Q      &kp W           &kp E     &kp R         &kp T                            &kp Y            &kp U  &kp I      &kp O    &kp P
&kp A      &kp S           &kp D     &kp F         &kp G                            &kp H            &kp J  &kp K      &kp L    &kp SEMI
&kp Z      &kp X           &kp C     &kp V         &kp B                            &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LEFT_SHIFT  &kp LALT  &lt 6 ESCAPE  &lt 2 SPACE  &lt 5 TAB  &kp RET  &lt 4 BACKSPACE                             &kp LEFT_WIN
            >;
        };

        mouse_autolayer {
            label = "AUTO-MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans  &trans     &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &mkp LCLK  &mo 7   &mkp RCLK  &mkp MCLK
&trans  &trans  &trans  &trans  &trans                       &trans  &trans     &mo 8   &trans     &trans
&trans  &trans  &trans  &trans  &lt 2 SPACE  &trans  &trans  &trans                                &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp N1            &kp N2          &kp N3        &kp N4     &kp N5                  &kp N6         &kp N7          &kp N8  &kp N9     &kp N0
&kp LEFT_ARROW    &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none                   &kp PAGE_UP    &mkp LCLK       &mo 7   &mkp RCLK  &mkp MCLK
&kp Z             &kp X           &kp C         &kp V      &kp Y                   &kp PAGE_DOWN  &kp UNDERSCORE  &mo 8   &kp DOT    &kp COMMA
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_ALT  &trans     &trans  &trans  &trans  &trans                                            &kp MINUS
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LEFT      &kp DOWN      &kp UP_ARROW  &kp RIGHT     &none                         &kp MINUS     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS
&none         &none         &none         &none         &none                         &kp SLASH     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp DOT
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                                                  &kp ASTERISK
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN     &kp HASH      &kp DOLLAR       &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none                        &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&trans           &trans          &trans        &trans           &trans                       &kp UNDERSCORE  &kp PLUS       &kp SLASH         &kp NON_US_BACKSLASH  &kp GRAVE
&trans           &trans          &trans        &trans           &trans       &trans  &trans  &trans                                                                 &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&kp F1            &kp F2          &kp F3        &kp F4        &kp F5                           &kp HOME  &none           &kp UP_ARROW    &kp PAGE_UP      &kp INS
&kp F6            &kp F7          &kp F8        &kp F9        &kp F10                          &kp END   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp DEL
&kp F11           &kp F12         &none         &kp CAPSLOCK  &kp PRINTSCREEN                  &none     &none           &none           &kp PAGE_DOWN    &none
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &kt LEFT_ALT  &trans        &trans           &trans  &trans  &trans                                                     &kp KP_NUMLOCK
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &mkp LCLK  &mo 7   &mkp RCLK  &mkp MCLK
&trans  &trans  &trans  &trans  &trans                  &trans  &trans     &mo 8   &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                                &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &none   &none      &none  &none      &none
&trans  &trans  &trans  &trans  &trans                  &none   &mkp LCLK  &none  &mkp RCLK  &none
&trans  &trans  &trans  &trans  &trans                  &none   &none      &none  &none      &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                               &none
            >;
        };

        caret_scroll_layer {
            label = "CARET-SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &none   &none  &none  &none  &none
&trans  &trans  &trans  &trans  &trans                  &none   &none  &none  &none  &none
&trans  &trans  &trans  &trans  &trans                  &none   &none  &none  &none  &none
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                       &none
            >;
        };

        config_layer {
            bindings = <
&bt BT_CLR    &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans
&trans        &trans        &trans        &trans        &trans                        &trans  &trans  &trans  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &trans  &trans  &trans  &trans  &trans
&bootloader   &trans        &trans        &trans        &trans        &trans  &trans  &trans                          &bootloader
            >;

            label = "CONF";
        };
    };
};
